meta {
  name: 01 Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "admin@enlasate.mx",
    "password": "Enlasate2026!"
  }
}

script:post-response {
  bru.setEnvVar("token", res.body.token);
}

tests {
  test("responde 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("devuelve token", function() {
    expect(res.getBody().token).to.be.a("string");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
